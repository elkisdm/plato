{
  "name": "@plato/schema",
  "version": "0.1.0",
  "private": true,
  "description": "VideoSpec — schema Zod generado desde la fuente de verdad JSON Schema (ADR-0001)",
  "type": "module",
  "main": "src/index.ts",
  "scripts": {
    "codegen": "json-schema-to-zod -i ../schema/videospec.schema.json -o ../schema/generated/zod.ts -n videoSpecSchema -t VideoSpec -d 100 -zv 3",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "studio": "remotion studio src/remotion/index.ts",
    "render": "remotion render src/remotion/index.ts SpecComposition out/spec.mp4"
  },
  "dependencies": {
    "@remotion/cli": "^4.0.475",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "remotion": "^4.0.475",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@devground/tsconfig": "^2.0.0",
    "@types/node": "^25.9.3",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "json-schema-to-zod": "^2.4.1",
    "typescript": "^5.5.0",
    "vitest": "^4.1.8"
  }
}
