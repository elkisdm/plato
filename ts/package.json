{
  "name": "@plato/schema",
  "version": "0.1.0",
  "private": true,
  "description": "VideoSpec — schema Zod generado desde la fuente de verdad JSON Schema (ADR-0001)",
  "type": "module",
  "main": "src/index.ts",
  "scripts": {
    "codegen": "json-schema-to-zod -i ../schema/videospec.schema.json -o ../schema/generated/zod.ts -n videoSpecSchema -t VideoSpec -d 100 -zv 3",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "studio": "remotion studio src/remotion/index.ts",
    "render": "remotion render src/remotion/index.ts SpecComposition out/spec.mp4"
  },
  "dependencies": {
    "@react-three/drei": "^10.7.8",
    "@react-three/fiber": "^9.8.0",
    "@react-three/postprocessing": "^3.1.2",
    "@remotion/cli": "^4.0.475",
    "@remotion/google-fonts": "4.0.475",
    "@remotion/lottie": "4.0.475",
    "@remotion/three": "4.0.475",
    "@remotion/transitions": "4.0.475",
    "d3-geo": "^3.1.1",
    "lottie-web": "^5.13.0",
    "opentype.js": "^2.0.0",
    "postprocessing": "^6.39.5",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "remotion": "^4.0.475",
    "three": "^0.186.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@devground/tsconfig": "^2.0.0",
    "@types/d3-geo": "^3.1.1",
    "@types/node": "^25.9.3",
    "@types/opentype.js": "^1.3.10",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@types/three": "^0.186.0",
    "json-schema-to-zod": "^2.4.1",
    "mapshaper": "^0.7.61",
    "typescript": "^5.5.0",
    "vitest": "^4.1.8"
  }
}
